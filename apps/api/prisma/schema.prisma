generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum OnboardingStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model User {
  id                String             @id @default(cuid())
  googleId          String             @unique
  email             String             @unique
  name              String
  handle            String?            @unique
  avatarUrl         String?
  onboardingStatus  OnboardingStatus   @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  association       Association?
  addedEntries      BirthdayDetails[]  @relation("AddedBy")
  sentConnections     Connection[]     @relation("ConnectionRequester")
  receivedConnections Connection[]     @relation("ConnectionAddressee")
  notifications       Notification[]   @relation("NotificationRecipient")
  actedNotifications  Notification[]   @relation("NotificationActor")
  uploadedAssets    Asset[]
  assignedCommissions      Commission[]              @relation("CommissionAssignee")
  commissionNotes          CommissionNote[]           @relation("CommissionNoteAuthor")
  commissionStatusChanges  CommissionStatusHistory[]  @relation("CommissionStatusChangedBy")
}

enum AppScope {
  ALL
  WORKSHOP
  ART
  FRIENDS
  WWW
  TRAVEL
}

model AppConfig {
  id        String   @id @default(cuid())
  type      String
  scope     AppScope
  value     String
  updatedAt DateTime @updatedAt

  @@unique([type, scope])
}

/// One-to-one link between a logged-in Account and the BirthdayDetails entry
/// that represents them. Once created, it is permanent — see BirthdayDetails
/// service logic: "deleting" an associated entry only clears its fields, it
/// never removes the row or the association, so the slot can't be re-claimed.
model Association {
  id                String          @id @default(cuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id])
  birthdayDetailsId String          @unique
  birthdayDetails   BirthdayDetails @relation(fields: [birthdayDetailsId], references: [id])
  createdAt         DateTime        @default(now())
}

model SocialPlatform {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  baseUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FriendVisibility {
  PUBLIC
  FRIENDS_ONLY
  NONE
}

/// A birthday/profile entry. May or may not be linked to a logged-in Account
/// (via Association) — most entries are added by someone about a third party
/// and stay unassociated forever; only entries created via onboarding (or
/// later claimed) end up associated.
model BirthdayDetails {
  id              String           @id @default(cuid())
  name            String
  birthYear       Int?
  birthMonth      Int?
  birthDay        Int?
  socialMedias    Json?
  preferAnonymous Boolean          @default(true)
  visibility      FriendVisibility @default(PUBLIC)
  avatarUrl       String?
  avatarKey       String?
  gcalEventId     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  addedById       String?
  addedBy         User?            @relation("AddedBy", fields: [addedById], references: [id])

  association     Association?
}

/// A previously-current avatar image for whatever owns it (a User account, a
/// friends BirthdayDetails profile, ...), kept as history when it's replaced
/// instead of being deleted from storage outright. Deliberately not FK'd to
/// any one table — ownerId is just that owner's id, and since every model in
/// this schema uses globally-unique cuids, it unambiguously identifies its
/// owner without needing a type tag. See modules/avatars.
model AvatarVersion {
  id        String   @id @default(cuid())
  ownerId   String
  key       String
  url       String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

/// Mutual account-to-account connection, requiring the addressee's consent.
/// Stored as one row per pair with directional columns (requester sent it,
/// addressee answers it) but read as symmetric: any "my connections" query
/// must match requesterId OR addresseeId. Deliberately not tied to
/// BirthdayDetails — this is the account-level social graph every app in the
/// workspace shares. "Who knows this birthday entry" is answered by
/// BirthdayDetails.addedById instead.
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id])
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  BIRTHDAY_REMINDER
  SYSTEM
}

/// Cross-app notification inbox, shared by every app in the workspace (see
/// AppScope). `subjectId` is deliberately NOT a foreign key — same trick as
/// AvatarVersion.ownerId: every model here uses globally-unique cuids, and
/// `type` already says which table to resolve it from, so one column serves
/// Connection / BirthdayDetails / Commission / ... without a nullable FK per
/// app. Content is never denormalized — handles are mutable and "deleted"
/// BirthdayDetails entries are field-cleared rather than removed, so names are
/// re-resolved at read time. `data` carries only immutable point-in-time facts;
/// if it can change, it doesn't belong there.
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  scope       AppScope         @default(FRIENDS)
  type        NotificationType
  subjectId   String?
  data        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@unique([recipientId, type, subjectId])
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt(sort: Desc)])
}

/// A media asset (image) uploaded to storage via the images.sign presigned
/// flow. This model is the persisted record of that upload — filename,
/// dimensions, size and tags are captured client-side at upload time and
/// sent along when the record is created, since the API never touches the
/// file bytes.
model Asset {
  id          String   @id @default(cuid())
  key         String   @unique
  publicUrl   String
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
}

enum CommissionStatus {
  NOT_YET_STARTED
  QUEUED
  SKETCH
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_YET
  REQUESTED
  PARTIAL
  FULL
}

enum CommissionNoteVisibility {
  INTERNAL
  CLIENT
}

enum CommissionType {
  ICON
  HALF_BODY
  FULL_BODY
  SKETCH_PAGE
}

enum PreferredContactMethod {
  EMAIL
  DISCORD
  TELEGRAM
  TWITTER
  OTHER
}

/// Admin-configurable base price for a CommissionType, in USD cents.
model CommissionTypePricing {
  id             String         @id @default(cuid())
  type           CommissionType @unique
  basePriceCents Int
  active         Boolean        @default(true)
  updatedAt      DateTime       @updatedAt
}

/// Admin-configurable rendering option (e.g. "Sketched" at -40%), applied as
/// a percentage modifier on top of the CommissionType base price.
model CommissionOptionPricing {
  id              String   @id @default(cuid())
  key             String   @unique
  modifierPercent Int
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/// Admin-configurable add-on (e.g. "Background"). minPriceCents is a floor —
/// the actual quote for an addon is set manually per-commission since these
/// are "from $X" rather than fixed.
model CommissionAddonPricing {
  id            String   @id @default(cuid())
  key           String   @unique
  minPriceCents Int
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

/// Singleton row (there is always exactly one) holding the rush-fee surcharge
/// applied when a client picks a deadline within thresholdDays.
model CommissionRushFeeSetting {
  id            String   @id @default(cuid())
  thresholdDays Int      @default(10)
  feeCents      Int      @default(2500)
  updatedAt     DateTime @updatedAt
}

model Commission {
  id          String    @id @default(cuid())
  title       String
  description String
  deadline    DateTime?

  status        CommissionStatus @default(NOT_YET_STARTED)
  paymentStatus PaymentStatus    @default(NOT_YET)
  isHidden      Boolean          @default(false)

  commissionType CommissionType?
  optionKey      String?
  addonKeys      String[]        @default([])
  quoteCents     Int?

  clientName             String
  clientEmail            String
  preferredContactMethod PreferredContactMethod @default(EMAIL)
  contactHandle          String?
  accessCode             String                 @unique @default(cuid())

  referenceAssets   String[] @default([])
  deliverableAssets String[] @default([])
  deliveredAt       DateTime?

  ideaConfirmedAt   DateTime?
  sketchConfirmedAt DateTime?
  paymentConfirmedAt DateTime?
  lineDoneAt        DateTime?
  coloringDoneAt     DateTime?
  finishedAt         DateTime?

  assignedToId String?
  assignedTo   User?   @relation("CommissionAssignee", fields: [assignedToId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes   CommissionNote[]
  history CommissionStatusHistory[]
}

/// A curated group of finished commissions, shown together as a set in the
/// public gallery (e.g. a themed batch or series). Unlike Commission,
/// isHidden defaults to false since projects are admin-curated for display.
model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  commissions Commission[]
}

model CommissionNote {
  id           String                    @id @default(cuid())
  commissionId String
  commission   Commission                @relation(fields: [commissionId], references: [id])
  authorId     String?
  author       User?                     @relation("CommissionNoteAuthor", fields: [authorId], references: [id])
  visibility   CommissionNoteVisibility  @default(INTERNAL)
  body         String
  createdAt    DateTime                  @default(now())
}

model CommissionStatusHistory {
  id           String            @id @default(cuid())
  commissionId String
  commission   Commission        @relation(fields: [commissionId], references: [id])
  fromStatus   CommissionStatus?
  toStatus     CommissionStatus
  changedById  String
  changedBy    User              @relation("CommissionStatusChangedBy", fields: [changedById], references: [id])
  note         String?
  createdAt    DateTime          @default(now())
}
