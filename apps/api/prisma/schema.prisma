generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum OnboardingStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model Role {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  no        Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserRole[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([roleId])
}

/// Login identity only — never displayed. See docs/specs/friends/profile-model.
model User {
  id               String           @id @default(cuid())
  googleId         String           @unique
  email            String           @unique
  name             String
  avatarUrl        String?
  onboardingStatus OnboardingStatus @default(PENDING)
  timezone         String           @default("UTC")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  profile                 Profile?                  @relation("ProfileOwner")
  addedProfiles           Profile[]                 @relation("AddedBy")
  sentConnections         Connection[]              @relation("ConnectionRequester")
  receivedConnections     Connection[]              @relation("ConnectionAddressee")
  notifications           Notification[]            @relation("NotificationRecipient")
  actedNotifications      Notification[]            @relation("NotificationActor")
  uploadedAssets          Asset[]
  roles                   UserRole[]
  settings                UserSetting[]
  queuedEmails            EmailOutbox[]             @relation("EmailOutboxRecipient")
  commissions             Commission[]              @relation("CommissionArtist")
  commissionOpenings      CommissionOpening[]       @relation("ArtistCommissionOpenings")
  commissionGroups        CommissionGroup[]         @relation("ArtistCommissionGroups")
  projects                Project[]                 @relation("ArtistProjects")
  commissionTypes         ArtistCommissionType[]    @relation("ArtistCommissionTypes")
  commissionOptions       CommissionOption[]        @relation("ArtistCommissionOptions")
  commissionAddons        CommissionAddon[]         @relation("ArtistCommissionAddons")
  commissionFollowers     CommissionFollower[]      @relation("ArtistFollowers")
  clientAccount           Client?                   @relation("ClientAccount")
  commissionStatusChanges CommissionStatusHistory[] @relation("CommissionStatusChangedBy")
}

enum AppScope {
  ALL
  WORKSHOP
  ART
  FRIENDS
  WWW
  TRAVEL
}

model SystemParameters {
  id        String   @id @default(cuid())
  type      String
  scope     AppScope
  value     String
  updatedAt DateTime @updatedAt

  @@unique([type, scope])
}

model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  scope     AppScope
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, scope])
  @@index([userId, scope])
}

model SocialPlatform {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  baseUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FriendVisibility {
  PUBLIC
  FRIENDS_ONLY
  NONE
}

/// The public half of a person. `userId` is null until claimed, and permanent
/// once set. See docs/specs/friends/profile-model.
model Profile {
  id           String   @id @default(cuid())
  displayName  String
  handle       String?  @unique
  avatarUrl    String?
  avatarKey    String?
  socialMedias Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String? @unique
  user   User?   @relation("ProfileOwner", fields: [userId], references: [id])

  addedById String?
  addedBy   User?   @relation("AddedBy", fields: [addedById], references: [id])

  birthday Birthday?
}

/// Absent row means no birthday known, which is why month/day are required.
/// See docs/specs/friends/profile-model.
model Birthday {
  id          String           @id @default(cuid())
  profileId   String           @unique
  profile     Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  year        Int?
  month       Int
  day         Int
  visibility  FriendVisibility @default(PUBLIC)
  gcalEventId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([month, day])
}

/// Replaced avatars, kept as history. `ownerId` is intentionally not a foreign
/// key. See docs/specs/friends/profile-model.
model AvatarVersion {
  id        String   @id @default(cuid())
  ownerId   String
  key       String
  url       String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

/// Directional columns, read symmetrically: "my connections" must match
/// requesterId OR addresseeId. See docs/specs/friends/connections-graph.
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id])
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  CONNECTION_ACCEPTED_BY_YOU
  CONNECTION_REJECTED
  CONNECTION_REJECTED_BY_YOU
  BIRTHDAY_REMINDER
  SYSTEM
}

/// `subjectId` is intentionally not a foreign key; `type` says which table to
/// resolve it from. See docs/specs/friends/connections-graph.
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  scope       AppScope         @default(FRIENDS)
  type        NotificationType
  subjectId   String?
  data        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@unique([recipientId, type, subjectId])
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt(sort: Desc)])
}

enum EmailOutboxKind {
  SELF_BIRTHDAY
  FRIEND_BIRTHDAY_UPCOMING
  FRIEND_BIRTHDAY_TODAY
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// See docs/specs/friends/birthday-notifications.
model EmailOutbox {
  id          String            @id @default(cuid())
  kind        EmailOutboxKind
  recipientId String
  recipient   User              @relation("EmailOutboxRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  subjectId   String
  occursOn    DateTime          @db.Date
  leadDays    Int               @default(0)
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?
  claimedAt   DateTime?
  sentAt      DateTime?
  createdAt   DateTime          @default(now())

  @@unique([kind, recipientId, subjectId, occursOn, leadDays])
  @@index([status, createdAt])
  @@index([status, sentAt])
}

/// A media asset (image) uploaded to storage via the images.sign presigned
/// flow. This model is the persisted record of that upload — filename,
/// dimensions, size and tags are captured client-side at upload time and
/// sent along when the record is created, since the API never touches the
/// file bytes.
enum AssetSource {
  UPLOAD
  EXTERNAL_URL
}

enum AssetThumbnailStatus {
  PENDING
  READY
  FAILED
}

model Asset {
  id          String      @id @default(cuid())
  source      AssetSource @default(UPLOAD)
  key         String?     @unique
  publicUrl   String
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  tags        Tag[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  thumbnailKey    String?
  thumbnailUrl    String?
  thumbnailStatus AssetThumbnailStatus @default(PENDING)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
}

enum ProcessType {
  ASSET_THUMBNAIL
}

model ProcessQueue {
  id            String      @id @default(cuid())
  type          ProcessType
  refId         String
  attempts      Int         @default(0)
  lastError     String?
  nextAttemptAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([type, refId])
  @@index([nextAttemptAt])
}

enum CommissionStatus {
  PENDING
  ACCEPTED
  DECLINED
  NOT_YET_STARTED
  QUEUED
  SKETCH
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_YET
  REQUESTED
  PARTIAL
  FULL
}

enum Visibility {
  INTERNAL
  CLIENT
}

enum AuthorRole {
  ARTIST
  CLIENT
}

/// A tag is a searchable label the public gallery filters on. A CommissionType
/// always owns exactly one Tag (created alongside it); Assets can carry any
/// number of Tags, including ones that happen to match a CommissionType's tag.
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets          Asset[]
  commissionTypes CommissionType[]
}

/// Platform-wide, admin-curated catalog of commission types (e.g. Sketch,
/// Lineart, Icon, Bust, Full, Sketchpage, Comic, Animation). `key` is also the
/// i18n key suffix: commission.type.<key>.label. Artists opt into individual
/// types via ArtistCommissionType and price them via their own
/// CommissionOptions — a type itself carries no price.
model CommissionType {
  id     String @id @default(cuid())
  key    String @unique
  label  String
  no     Int      @default(0)
  active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tagId String?
  tag   Tag?    @relation(fields: [tagId], references: [id], onDelete: SetNull)

  artistTypes ArtistCommissionType[]
  options     CommissionOption[]
  details     CommissionDetail[]
}

/// An artist's enablement of a platform CommissionType. Existing only for
/// types the artist has turned on; `active` lets them toggle it back off
/// without losing their configured CommissionOptions.
model ArtistCommissionType {
  id       String @id @default(cuid())
  artistId String
  artist   User   @relation("ArtistCommissionTypes", fields: [artistId], references: [id], onDelete: Cascade)

  commissionTypeId String
  commissionType   CommissionType @relation(fields: [commissionTypeId], references: [id], onDelete: Cascade)

  no        Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, commissionTypeId])
}

enum PreferredContactMethod {
  EMAIL
  DISCORD
  TELEGRAM
  TWITTER
  OTHER
}

enum PriceMode {
  FIXED
  STARTING_FROM
  RANGE
  PERCENTAGE
}

/// An artist's priced variant of a CommissionType (e.g. "Flat color" at $40,
/// "Full render" starting at $70). A type with exactly one option is applied
/// directly to an order; a type with several renders as a dropdown for the
/// client to pick from. PERCENTAGE is not a valid mode here — an option has
/// nothing to take a percentage of.
model CommissionOption {
  id       String @id @default(cuid())
  artistId String
  artist   User   @relation("ArtistCommissionOptions", fields: [artistId], references: [id], onDelete: Cascade)

  commissionTypeId String
  commissionType   CommissionType @relation(fields: [commissionTypeId], references: [id], onDelete: Cascade)

  key       String
  label     String
  priceMode PriceMode @default(FIXED)
  minPrice  Int
  maxPrice  Int?
  no        Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, commissionTypeId, key])
}

/// Admin-configurable surcharge/discount an artist can attach to an order.
/// PERCENTAGE addons are computed against the price of whichever
/// CommissionOption the client selected.
model CommissionAddon {
  id       String @id @default(cuid())
  artistId String
  artist   User   @relation("ArtistCommissionAddons", fields: [artistId], references: [id], onDelete: Cascade)

  key       String
  label     String
  priceMode PriceMode @default(STARTING_FROM)
  minPrice  Int?
  maxPrice  Int?
  percent   Int?
  no        Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([artistId, key])
}

/// Singleton row (there is always exactly one) holding the rush-fee surcharge
/// applied when a client picks a deadline within thresholdDays.

model Commission {
  id       String           @id @default(cuid())
  status   CommissionStatus @default(PENDING)
  priority Int?

  artistId String
  artist   User   @relation("CommissionArtist", fields: [artistId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  commissionOpeningId String?
  commissionOpening   CommissionOpening? @relation(fields: [commissionOpeningId], references: [id], onDelete: SetNull)

  groupId String?
  group   CommissionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  accessCode String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detail   CommissionDetail?
  comments Comment[]
  history  CommissionStatusHistory[]
  progress CommissionProgress[]

  @@index([artistId, status])
  @@index([clientId])
  @@index([groupId])
}

model CommissionGroup {
  id          String  @id @default(cuid())
  title       String
  description String?

  artistId String
  artist   User   @relation("ArtistCommissionGroups", fields: [artistId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  accessCode String @unique @default(cuid())

  currency String @default("USD")
  quote    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     CommissionGroupMember[]
  commissions Commission[]
  comments    Comment[]

  @@index([artistId])
}

model CommissionGroupMember {
  id       String          @id @default(cuid())
  groupId  String
  group    CommissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId String
  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, clientId])
}

model Client {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  name                   String
  preferredContactMethod PreferredContactMethod @default(EMAIL)
  contactHandle          String?

  userId String? @unique
  user   User?   @relation("ClientAccount", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions      Commission[]
  groupMemberships CommissionGroupMember[]
  comments         Comment[]
}

model PaymentMethod {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  no        Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions Commission[]
}

model CommissionDetail {
  id           String     @id @default(cuid())
  commissionId String     @unique
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  idea     Json
  deadline DateTime?

  paymentStatus   PaymentStatus @default(NOT_YET)
  isHiddenInQueue Boolean       @default(false)

  commissionTypeId String?
  commissionType   CommissionType? @relation(fields: [commissionTypeId], references: [id], onDelete: SetNull)
  optionKey        String?
  addonKeys        String[]        @default([])

  currency      String @default("USD")
  quote         Int?
  originalQuote Int?

  referenceAssets String[]  @default([])
  deliveredAt     DateTime?

  ideaConfirmedAt    DateTime?
  sketchConfirmedAt  DateTime?
  paymentConfirmedAt DateTime?
  lineDoneAt         DateTime?
  coloringDoneAt     DateTime?
  finishedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommissionProgress {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title      String?
  body       Json?
  images     String[]   @default([])
  isFinal    Boolean    @default(false)
  visibility Visibility @default(CLIENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]

  @@index([commissionId, createdAt])
}

model Project {
  id          String  @id @default(cuid())
  title       String
  description String?
  brief       Json?

  artistId String
  artist   User   @relation("ArtistProjects", fields: [artistId], references: [id])

  isHidden  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups   CommissionGroup[]
  artworks CommissionProgress[]
  comments Comment[]

  @@index([artistId])
}

model Comment {
  id String @id @default(cuid())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  groupId String?
  group   CommissionGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  commissionId String?
  commission   Commission? @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  progressId String?
  progress   CommissionProgress? @relation(fields: [progressId], references: [id], onDelete: Cascade)

  authorRole     AuthorRole @default(ARTIST)
  authorClientId String?
  authorClient   Client?    @relation(fields: [authorClientId], references: [id], onDelete: SetNull)

  visibility Visibility @default(INTERNAL)
  body       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([groupId, createdAt])
  @@index([commissionId, createdAt])
  @@index([progressId, createdAt])
}

model CommissionStatusHistory {
  id           String            @id @default(cuid())
  commissionId String
  commission   Commission        @relation(fields: [commissionId], references: [id])
  fromStatus   CommissionStatus?
  toStatus     CommissionStatus
  changedById  String
  changedBy    User              @relation("CommissionStatusChangedBy", fields: [changedById], references: [id])
  note         String?
  createdAt    DateTime          @default(now())
}

enum CommissionOpeningEndMode {
  MANUAL
  SLOT_CAP
  INDEFINITE
}

enum CommissionOpeningStatus {
  SCHEDULED
  OPEN
  CLOSED
}

model CommissionOpening {
  id      String                   @id @default(cuid())
  status  CommissionOpeningStatus  @default(SCHEDULED)
  endMode CommissionOpeningEndMode

  artistId String
  artist   User   @relation("ArtistCommissionOpenings", fields: [artistId], references: [id], onDelete: Cascade)

  scheduledAt   DateTime?
  openedAt      DateTime?
  closedAt      DateTime?
  slotCap       Int?
  slotCapEndsAt DateTime?

  postTitle String?
  postBody  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions Commission[]

  @@index([artistId, status])
}

model CommissionFollower {
  id       String @id @default(cuid())
  artistId String
  artist   User   @relation("ArtistFollowers", fields: [artistId], references: [id], onDelete: Cascade)

  email            String
  isActive         Boolean  @default(true)
  unsubscribeToken String   @unique @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([artistId, email])
}
