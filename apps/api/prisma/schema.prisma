generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Message {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialPlatform {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  baseUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Friend {
  id              String   @id @default(cuid())
  name            String
  birthYear       Int?
  birthMonth      Int?
  birthDay        Int?
  socialMedias    Json?
  preferAnonymous Boolean  @default(true)
  avatarUrl       String?
  avatarKey       String?
  gcalEventId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
