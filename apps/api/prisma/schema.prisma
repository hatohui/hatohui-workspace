generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum OnboardingStatus {
  PENDING
  COMPLETED
  SKIPPED
}

/// Login identity only — never displayed. See docs/specs/friends/profile-model.
model User {
  id                String             @id @default(cuid())
  googleId          String             @unique
  email             String             @unique
  name              String
  avatarUrl         String?
  onboardingStatus  OnboardingStatus   @default(PENDING)
  timezone          String             @default("UTC")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  profile           Profile?           @relation("ProfileOwner")
  addedProfiles     Profile[]          @relation("AddedBy")
  sentConnections     Connection[]     @relation("ConnectionRequester")
  receivedConnections Connection[]     @relation("ConnectionAddressee")
  notifications       Notification[]   @relation("NotificationRecipient")
  actedNotifications  Notification[]   @relation("NotificationActor")
  uploadedAssets    Asset[]
  settings          UserSetting[]
  queuedEmails      EmailOutbox[]      @relation("EmailOutboxRecipient")
  assignedCommissions      Commission[]              @relation("CommissionAssignee")
  commissionNotes          CommissionNote[]           @relation("CommissionNoteAuthor")
  commissionStatusChanges  CommissionStatusHistory[]  @relation("CommissionStatusChangedBy")
}

enum AppScope {
  ALL
  WORKSHOP
  ART
  FRIENDS
  WWW
  TRAVEL
}

model SystemParameters {
  id        String   @id @default(cuid())
  type      String
  scope     AppScope
  value     String
  updatedAt DateTime @updatedAt

  @@unique([type, scope])
}

model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  scope     AppScope
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, scope])
  @@index([userId, scope])
}

model SocialPlatform {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  baseUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FriendVisibility {
  PUBLIC
  FRIENDS_ONLY
  NONE
}

/// The public half of a person. `userId` is null until claimed, and permanent
/// once set. See docs/specs/friends/profile-model.
model Profile {
  id           String           @id @default(cuid())
  displayName  String
  handle       String?          @unique
  avatarUrl    String?
  avatarKey    String?
  socialMedias Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  userId       String?          @unique
  user         User?            @relation("ProfileOwner", fields: [userId], references: [id])

  addedById    String?
  addedBy      User?            @relation("AddedBy", fields: [addedById], references: [id])

  birthday     Birthday?
}

/// Absent row means no birthday known, which is why month/day are required.
/// See docs/specs/friends/profile-model.
model Birthday {
  id          String           @id @default(cuid())
  profileId   String           @unique
  profile     Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  year        Int?
  month       Int
  day         Int
  visibility  FriendVisibility @default(PUBLIC)
  gcalEventId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([month, day])
}

/// Replaced avatars, kept as history. `ownerId` is intentionally not a foreign
/// key. See docs/specs/friends/profile-model.
model AvatarVersion {
  id        String   @id @default(cuid())
  ownerId   String
  key       String
  url       String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

/// Directional columns, read symmetrically: "my connections" must match
/// requesterId OR addresseeId. See docs/specs/friends/connections-graph.
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id])
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  CONNECTION_ACCEPTED_BY_YOU
  CONNECTION_REJECTED
  CONNECTION_REJECTED_BY_YOU
  BIRTHDAY_REMINDER
  SYSTEM
}

/// `subjectId` is intentionally not a foreign key; `type` says which table to
/// resolve it from. See docs/specs/friends/connections-graph.
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  scope       AppScope         @default(FRIENDS)
  type        NotificationType
  subjectId   String?
  data        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@unique([recipientId, type, subjectId])
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt(sort: Desc)])
}

enum EmailOutboxKind {
  SELF_BIRTHDAY
  FRIEND_BIRTHDAY_UPCOMING
  FRIEND_BIRTHDAY_TODAY
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// See docs/specs/friends/birthday-notifications.
model EmailOutbox {
  id          String            @id @default(cuid())
  kind        EmailOutboxKind
  recipientId String
  recipient   User              @relation("EmailOutboxRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  subjectId   String
  occursOn    DateTime          @db.Date
  leadDays    Int               @default(0)
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?
  claimedAt   DateTime?
  sentAt      DateTime?
  createdAt   DateTime          @default(now())

  @@unique([kind, recipientId, subjectId, occursOn, leadDays])
  @@index([status, createdAt])
  @@index([status, sentAt])
}

/// A media asset (image) uploaded to storage via the images.sign presigned
/// flow. This model is the persisted record of that upload — filename,
/// dimensions, size and tags are captured client-side at upload time and
/// sent along when the record is created, since the API never touches the
/// file bytes.
enum AssetSource {
  UPLOAD
  EXTERNAL_URL
}

enum AssetThumbnailStatus {
  PENDING
  READY
  FAILED
}

model Asset {
  id          String      @id @default(cuid())
  source      AssetSource @default(UPLOAD)
  key         String?     @unique
  publicUrl   String
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  tags        String[]    @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  thumbnailKey    String?
  thumbnailUrl    String?
  thumbnailStatus AssetThumbnailStatus @default(PENDING)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
}

enum ProcessType {
  ASSET_THUMBNAIL
}

model ProcessQueue {
  id            String      @id @default(cuid())
  type          ProcessType
  refId         String
  attempts      Int         @default(0)
  lastError     String?
  nextAttemptAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([type, refId])
  @@index([nextAttemptAt])
}

enum CommissionStatus {
  NOT_YET_STARTED
  QUEUED
  SKETCH
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_YET
  REQUESTED
  PARTIAL
  FULL
}

enum CommissionNoteVisibility {
  INTERNAL
  CLIENT
}

enum CommissionType {
  ICON
  HALF_BODY
  FULL_BODY
  SKETCH_PAGE
}

enum PreferredContactMethod {
  EMAIL
  DISCORD
  TELEGRAM
  TWITTER
  OTHER
}

/// Admin-configurable base price for a CommissionType, in USD cents.
model CommissionTypePricing {
  id             String         @id @default(cuid())
  type           CommissionType @unique
  basePriceCents Int
  active         Boolean        @default(true)
  updatedAt      DateTime       @updatedAt
}

/// Admin-configurable rendering option (e.g. "Sketched" at -40%), applied as
/// a percentage modifier on top of the CommissionType base price.
model CommissionOptionPricing {
  id              String   @id @default(cuid())
  key             String   @unique
  modifierPercent Int
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/// Admin-configurable add-on (e.g. "Background"). minPriceCents is a floor —
/// the actual quote for an addon is set manually per-commission since these
/// are "from $X" rather than fixed.
model CommissionAddonPricing {
  id            String   @id @default(cuid())
  key           String   @unique
  minPriceCents Int
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

/// Singleton row (there is always exactly one) holding the rush-fee surcharge
/// applied when a client picks a deadline within thresholdDays.
model CommissionRushFeeSetting {
  id            String   @id @default(cuid())
  thresholdDays Int      @default(10)
  feeCents      Int      @default(2500)
  updatedAt     DateTime @updatedAt
}

model Commission {
  id          String    @id @default(cuid())
  title       String
  description String
  deadline    DateTime?

  status        CommissionStatus @default(NOT_YET_STARTED)
  paymentStatus PaymentStatus    @default(NOT_YET)
  isHidden      Boolean          @default(false)

  commissionType CommissionType?
  optionKey      String?
  addonKeys      String[]        @default([])
  quoteCents     Int?

  clientName             String
  clientEmail            String
  preferredContactMethod PreferredContactMethod @default(EMAIL)
  contactHandle          String?
  accessCode             String                 @unique @default(cuid())

  referenceAssets   String[] @default([])
  deliverableAssets String[] @default([])
  deliveredAt       DateTime?

  ideaConfirmedAt   DateTime?
  sketchConfirmedAt DateTime?
  paymentConfirmedAt DateTime?
  lineDoneAt        DateTime?
  coloringDoneAt     DateTime?
  finishedAt         DateTime?

  assignedToId String?
  assignedTo   User?   @relation("CommissionAssignee", fields: [assignedToId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes   CommissionNote[]
  history CommissionStatusHistory[]
}

/// A curated group of finished commissions, shown together as a set in the
/// public gallery (e.g. a themed batch or series). Unlike Commission,
/// isHidden defaults to false since projects are admin-curated for display.
model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  commissions Commission[]
}

model CommissionNote {
  id           String                    @id @default(cuid())
  commissionId String
  commission   Commission                @relation(fields: [commissionId], references: [id])
  authorId     String?
  author       User?                     @relation("CommissionNoteAuthor", fields: [authorId], references: [id])
  visibility   CommissionNoteVisibility  @default(INTERNAL)
  body         String
  createdAt    DateTime                  @default(now())
}

model CommissionStatusHistory {
  id           String            @id @default(cuid())
  commissionId String
  commission   Commission        @relation(fields: [commissionId], references: [id])
  fromStatus   CommissionStatus?
  toStatus     CommissionStatus
  changedById  String
  changedBy    User              @relation("CommissionStatusChangedBy", fields: [changedById], references: [id])
  note         String?
  createdAt    DateTime          @default(now())
}
