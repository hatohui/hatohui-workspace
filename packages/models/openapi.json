  "info": {
    "title": "Hatohui API",
    "description": "OpenAPI specification for the Hatohui workspace API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": ""
    },
    {
      "name": "friends",
      "description": ""
    },
    {
      "name": "health",
      "description": ""
    },
    {
      "name": "images",
      "description": ""
    },
    {
      "name": "platforms",
      "description": ""
    },
    {
      "name": "onboarding",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "GoogleLoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "Google Identity Services ID token"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          },
          "onboardingStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETED",
              "SKIPPED"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "avatarUrl",
          "role",
          "onboardingStatus"
        ]
      },
      "MessageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1",
            "description": "Unique message id"
          },
          "text": {
            "type": "string",
            "example": "Hello from the API!"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-07-23T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "text",
          "createdAt"
        ]
      },
      "FriendDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx1234567890",
            "description": "Unique friend id"
          },
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "birthYear": {
            "type": "number",
            "example": 1998,
            "nullable": true,
            "description": "Birth year"
          },
          "birthMonth": {
            "type": "number",
            "example": 5,
            "nullable": true,
            "description": "Birth month (1-12)"
          },
          "birthDay": {
            "type": "number",
            "example": 14,
            "nullable": true,
            "description": "Birth day (1-31)"
          },
          "socialMedias": {
            "type": "object",
            "example": {
              "Twitter": "@jane",
              "Instagram": "@jane.doe"
            },
            "nullable": true
          },
          "preferAnonymous": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "FRIENDS_ONLY",
              "NONE"
            ],
            "example": "PUBLIC"
          },
          "avatarUrl": {
            "type": "string",
            "example": "http://localhost:9000/hatohui-dev/images/abc123.jpg",
            "nullable": true,
            "description": "Public URL of the friend's avatar image"
          },
          "addedById": {
            "type": "string",
            "nullable": true,
            "description": "Id of the account that added this entry, if any"
          },
          "isAssociated": {
            "type": "boolean",
            "description": "Whether this entry is already claimed by an account"
          },
          "canEdit": {
            "type": "boolean",
            "description": "Whether the requesting viewer is allowed to edit/delete this entry"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-07-23T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-07-23T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "birthYear",
          "birthMonth",
          "birthDay",
          "socialMedias",
          "preferAnonymous",
          "visibility",
          "avatarUrl",
          "addedById",
          "isAssociated",
          "canEdit",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpcomingFriendDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx1234567890",
            "description": "Unique friend id"
          },
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "birthYear": {
            "type": "number",
            "example": 1998,
            "nullable": true,
            "description": "Birth year"
          },
          "birthMonth": {
            "type": "number",
            "example": 5,
            "nullable": true,
            "description": "Birth month (1-12)"
          },
          "birthDay": {
            "type": "number",
            "example": 14,
            "nullable": true,
            "description": "Birth day (1-31)"
          },
          "socialMedias": {
            "type": "object",
            "example": {
              "Twitter": "@jane",
              "Instagram": "@jane.doe"
            },
            "nullable": true
          },
          "preferAnonymous": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "FRIENDS_ONLY",
              "NONE"
            ],
            "example": "PUBLIC"
          },
          "avatarUrl": {
            "type": "string",
            "example": "http://localhost:9000/hatohui-dev/images/abc123.jpg",
            "nullable": true,
            "description": "Public URL of the friend's avatar image"
          },
          "addedById": {
            "type": "string",
            "nullable": true,
            "description": "Id of the account that added this entry, if any"
          },
          "isAssociated": {
            "type": "boolean",
            "description": "Whether this entry is already claimed by an account"
          },
          "canEdit": {
            "type": "boolean",
            "description": "Whether the requesting viewer is allowed to edit/delete this entry"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-07-23T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-07-23T00:00:00.000Z"
          },
          "turningAge": {
            "type": "number",
            "example": 28,
            "nullable": true,
            "description": "Age the friend is turning on their next birthday, null if birthYear is unknown"
          },
          "nextBirthdayDate": {
            "type": "string",
            "example": "2026-08-14",
            "description": "The friend's next occurring birthday date (year is the anchor year, not necessarily their birth year)"
          }
        },
        "required": [
          "id",
          "name",
          "birthYear",
          "birthMonth",
          "birthDay",
          "socialMedias",
          "preferAnonymous",
          "visibility",
          "avatarUrl",
          "addedById",
          "isAssociated",
          "canEdit",
          "createdAt",
          "updatedAt",
          "turningAge",
          "nextBirthdayDate"
        ]
      },
      "PaginatedFriendsDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FriendDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "SocialGraphNodeDto": {
        "type": "object",
        "properties": {
          "friend": {
            "$ref": "#/components/schemas/FriendDto"
          },
          "friendsOfFriend": {
            "description": "1-2 of this friend's own connections, if they have a claimed profile",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FriendDto"
            }
          }
        },
        "required": [
          "friend",
          "friendsOfFriend"
        ]
      },
      "SocialGraphDto": {
        "type": "object",
        "properties": {
          "friends": {
            "description": "Up to 10 of the viewer's connections",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SocialGraphNodeDto"
            }
          }
        },
        "required": [
          "friends"
        ]
      },
      "CreateFriendDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "birthYear": {
            "type": "number",
            "example": 1998
          },
          "birthMonth": {
            "type": "number",
            "example": 5
          },
          "birthDay": {
            "type": "number",
            "example": 14
          },
          "socialMedias": {
            "type": "object",
            "example": {
              "Twitter": "@jane",
              "Instagram": "@jane.doe"
            }
          },
          "preferAnonymous": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "FRIENDS_ONLY",
              "NONE"
            ],
            "default": "PUBLIC"
          },
          "avatarKey": {
            "type": "string",
            "example": "images/abc123.jpg",
            "description": "Object key returned by POST /images/sign, after uploading the avatar file to storage"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateFriendDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "birthYear": {
            "type": "number",
            "example": 1998
          },
          "birthMonth": {
            "type": "number",
            "example": 5
          },
          "birthDay": {
            "type": "number",
            "example": 14
          },
          "socialMedias": {
            "type": "object",
            "example": {
              "Twitter": "@jane",
              "Instagram": "@jane.doe"
            }
          },
          "preferAnonymous": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "FRIENDS_ONLY",
              "NONE"
            ],
            "default": "PUBLIC"
          },
          "avatarKey": {
            "type": "string",
            "example": "images/abc123.jpg",
            "description": "Object key returned by POST /images/sign, after uploading the avatar file to storage"
          }
        }
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          }
        },
        "required": [
          "status",
          "db",
          "redis"
        ]
      },
      "SignImageDto": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "example": "profile-photo.jpg"
          },
          "contentType": {
            "type": "string",
            "example": "image/jpeg",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp",
              "image/gif",
              "image/avif"
            ]
          }
        },
        "required": [
          "fileName",
          "contentType"
        ]
      },
      "SignedImageDto": {
        "type": "object",
        "properties": {
          "uploadUrl": {
            "type": "string",
            "description": "Presigned PUT URL the client uploads the file bytes to"
          },
          "key": {
            "type": "string",
            "description": "Object key the file was signed for"
          },
          "publicUrl": {
            "type": "string",
            "description": "Public URL the image is reachable at once uploaded"
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until uploadUrl expires"
          }
        },
        "required": [
          "uploadUrl",
          "key",
          "publicUrl",
          "expiresIn"
        ]
      },
      "SocialPlatformDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx1234567890",
            "description": "Unique platform id"
          },
          "key": {
            "type": "string",
            "example": "x",
            "description": "Stable identifier for the platform"
          },
          "name": {
            "type": "string",
            "example": "X (Twitter)"
          },
          "baseUrl": {
            "type": "string",
            "example": "https://x.com/",
            "description": "Base URL a handle is appended to"
          }
        },
        "required": [
          "id",
          "key",
          "name",
          "baseUrl"
        ]
      },
      "OnboardingStateDto": {
        "type": "object",
        "properties": {
          "onboardingStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETED",
              "SKIPPED"
            ]
          },
          "entry": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/FriendDto"
              }
            ]
          }
        },
        "required": [
          "onboardingStatus",
          "entry"
        ]
      },
      "OptInDto": {
        "type": "object",
        "properties": {
          "join": {
            "type": "boolean",
            "description": "Whether the user wants to join the list"
          }
        },
        "required": [
          "join"
        ]
      },
      "SetVisibilityDto": {
        "type": "object",
        "properties": {
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "FRIENDS_ONLY",
              "NONE"
            ]
          }
        },
        "required": [
          "visibility"
        ]
      },
      "SetBirthdayDto": {
        "type": "object",
        "properties": {
          "birthYear": {
            "type": "number"
          },
          "birthMonth": {
            "type": "number"
          },
          "birthDay": {
            "type": "number"
          }
        },
        "required": [
          "birthMonth",
          "birthDay"
        ]
      },
      "AddConnectionsDto": {
        "type": "object",
        "properties": {
          "birthdayDetailsIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "birthdayDetailsIds"
        ]
      }
    }
  }
}